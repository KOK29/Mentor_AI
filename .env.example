# Backend
DATABASE_URL=sqlite+aiosqlite:///./mentor_slm.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=1209600
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Verification demo mode: returns OTP in API response for local judging only.
# Set to 0 when an email/SMS provider is connected.
DEV_OTP_MODE=1
OTP_TTL_SECONDS=300

# Local Small Language Model (Ollama-compatible)
SLM_BASE_URL=http://localhost:11434
SLM_MODEL=qwen2.5:3b
SLM_TIMEOUT_SECONDS=20

# Frontend
VITE_API_BASE_URL=http://localhost:8000
